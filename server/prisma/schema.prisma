generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  OFFICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  MCQ2
  NUMERIC
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PerformanceBand {
  WEAK
  DEVELOPING
  STRONG
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model User {
  id             String   @id @default(cuid())
  passwordHash   String
  passwordPlain  String?  @map("password_plain")
  role           Role
  email          String?  @unique
  /// Login for students (e.g. admission number)
  studentLoginId String?  @unique @map("student_login_id")
  createdAt      DateTime @default(now()) @map("created_at")

  student Student?
  teacher Teacher?
  admin   Admin?
  office  Office?

  questionsCreated        Question[]          @relation("QuestionCreatedBy")
  questionImports         QuestionImport[]
  questionReportsResolved QuestionReport[]    @relation("QuestionReportResolvedBy")
  attendanceSessionsTaken AttendanceSession[] @relation("AttendanceTakenBy")
  classroomAssessmentsRecorded ClassroomAssessmentSession[] @relation("ClassroomRecordedBy")
  careCallsRecorded            CareCall[]                   @relation("CareCallRecordedBy")
  feeChargesCreated            FeeCharge[]                  @relation("FeeChargeCreatedBy")
  feePaymentsRecorded          FeePayment[]                 @relation("FeePaymentRecordedBy")
}

model Admin {
  id       String @id @default(cuid())
  userId   String @unique @map("user_id")
  fullName String @map("full_name")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Office {
  id       String @id @default(cuid())
  userId   String @unique @map("user_id")
  fullName String @map("full_name")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Teacher {
  id       String @id @default(cuid())
  userId   String @unique @map("user_id")
  fullName String @map("full_name")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolClass {
  id                 String              @id @default(cuid())
  name               String
  grade              String?
  sections           Section[]
  students           Student[]
  subjects             ClassSubject[]
  attendanceSessions   AttendanceSession[]
  classroomAssessments ClassroomAssessmentSession[]
  feeStructures        FeeStructure[]
}

model Section {
  id                 String              @id @default(cuid())
  classId            String              @map("class_id")
  name               String
  schoolClass        SchoolClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  students             Student[]
  attendanceSessions   AttendanceSession[]
  classroomAssessments ClassroomAssessmentSession[]
}

model Student {
  id          String      @id @default(cuid())
  userId      String      @unique @map("user_id")
  classId     String      @map("class_id")
  sectionId   String      @map("section_id")
  fullName    String      @map("full_name")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  tests             Test[]
  studentProgress   StudentProgress[]
  topicPerformance  TopicPerformance[]
  attendanceEntries AttendanceEntry[]
  engagement        StudentEngagement?
  xpEvents          XpEvent[]
  dailyChallenges   DailyChallenge[]
  topicMasteries             TopicMastery[]
  masterySessions            MasterySession[]
  classroomAssessmentEntries ClassroomAssessmentEntry[]
  careCalls                  CareCall[]
  feeMembership              FeeAccountMember?
  feePaymentsAgainst         FeePayment[]       @relation("FeePaymentAgainstStudent")
  questionReports            QuestionReport[]

  @@index([classId, sectionId])
}

enum XpReason {
  CHECK_IN
  DAILY_CHALLENGE
  DAILY_CHALLENGE_BONUS
  TOPIC_PRACTICE
  TOPIC_MASTERY
}

enum DailyChallengeStatus {
  IN_PROGRESS
  COMPLETED
}

enum TopicMasteryStatus {
  NEEDS_WORK
  LEARNING
  PRACTICING
  REVIEW_DUE
  MASTERED
}

enum MasterySessionKind {
  PRACTICE
  RECHECK
}

enum MasterySessionStatus {
  IN_PROGRESS
  COMPLETED
}

/// Gamification totals + streaks for daily engagement.
model StudentEngagement {
  id                 String    @id @default(cuid())
  studentId          String    @unique @map("student_id")
  xpTotal            Int       @default(0) @map("xp_total")
  checkInStreak      Int       @default(0) @map("check_in_streak")
  bestCheckInStreak  Int       @default(0) @map("best_check_in_streak")
  practiceStreak     Int       @default(0) @map("practice_streak")
  bestPracticeStreak Int       @default(0) @map("best_practice_streak")
  /// YYYY-MM-DD (IST calendar day)
  lastCheckInDay     String?   @map("last_check_in_day")
  lastPracticeDay    String?   @map("last_practice_day")
  lastLoginDay       String?   @map("last_login_day")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lastLoginDay])
}

model XpEvent {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  amount    Int
  reason    XpReason
  /// YYYY-MM-DD — used to enforce one check-in XP per day
  dayKey    String   @map("day_key")
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, dayKey])
  @@index([studentId, reason, dayKey])
}

/// One auto-built skill Daily 5 per student per calendar day.
model DailyChallenge {
  id           String               @id @default(cuid())
  studentId    String               @map("student_id")
  dayKey       String               @map("day_key")
  subjectId    String               @map("subject_id")
  levelId      String               @map("level_id")
  status       DailyChallengeStatus @default(IN_PROGRESS)
  focusTopicNames String[]          @default([]) @map("focus_topic_names")
  score        Int?
  maxScore     Int?                 @map("max_score")
  percentage   Float?
  xpAwarded    Int?                 @map("xp_awarded")
  startedAt    DateTime             @default(now()) @map("started_at")
  completedAt  DateTime?            @map("completed_at")

  student   Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level     Level                    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  questions DailyChallengeQuestion[]

  @@unique([studentId, dayKey])
  @@index([studentId, dayKey])
  @@index([subjectId])
}

model DailyChallengeQuestion {
  id             String  @id @default(cuid())
  challengeId    String  @map("challenge_id")
  questionId     String  @map("question_id")
  orderIndex     Int     @map("order_index")
  selectedOption Int?    @map("selected_option")
  numericAnswer  Float?  @map("numeric_answer")
  isCorrect      Boolean? @map("is_correct")

  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question  Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([challengeId, orderIndex])
  @@index([challengeId])
}

model SubjectArea {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String?
  sortOrder Int       @default(0) @map("sort_order")
  subjects  Subject[]
}

model Subject {
  id                       String          @id @default(cuid())
  name                     String
  code                     String?
  areaId                   String?         @map("area_id")
  area                     SubjectArea?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// LEVEL = existing skill tests. CHAPTER = book chapters, no unlock ladder.
  testMode                 SubjectTestMode @default(LEVEL) @map("test_mode")
  chapterTestQuestionCount Int             @default(10) @map("chapter_test_question_count")
  /// When on, a chapter test draws more questions from chapters/topics with a larger bank.
  chapterWeightByBank      Boolean         @default(false) @map("chapter_weight_by_bank")
  chapterNegativeMarking   Boolean         @default(false) @map("chapter_negative_marking")
  /// Marks subtracted per wrong answer when chapterNegativeMarking is on (e.g. 0.25).
  chapterWrongPenalty      Float           @default(0.25) @map("chapter_wrong_penalty")
  levels                   Level[]
  chapters                 SubjectChapter[]
  questions                Question[]
  tests                    Test[]
  classSubjects            ClassSubject[]
  studentProgress          StudentProgress[]
  dailyChallenges          DailyChallenge[]
  topicMasteries           TopicMastery[]
  classroomAssessments     ClassroomAssessmentSession[]

  @@index([areaId])
}

/// Chapters attached to a CHAPTER-mode branch (e.g. NCERT book).
model SubjectChapter {
  id        String  @id @default(cuid())
  subjectId String  @map("subject_id")
  topicId   String  @map("topic_id")
  sortOrder Int     @default(0) @map("sort_order")
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chapterTopics ChapterTopic[]

  @@unique([subjectId, topicId])
  @@index([subjectId])
}

/// Optional folder inside a book chapter. Absent on smaller-class chapters.
model ChapterTopic {
  id               String         @id @default(cuid())
  subjectChapterId String         @map("subject_chapter_id")
  name             String
  sortOrder        Int            @default(0) @map("sort_order")
  subjectChapter   SubjectChapter @relation(fields: [subjectChapterId], references: [id], onDelete: Cascade)
  questions        Question[]

  @@unique([subjectChapterId, name])
  @@index([subjectChapterId])
}

/// Join: which subjects a class studies (students see these subjects)
model ClassSubject {
  id          String      @id @default(cuid())
  classId     String      @map("class_id")
  subjectId   String      @map("subject_id")
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
}

model Level {
  id                       String                    @id @default(cuid())
  subjectId                String                    @map("subject_id")
  order                    Int
  name                     String
  subject                  Subject                   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions                Question[]
  tests                    Test[]
  testConfig               LevelTestConfig?
  levelTopicParticipations LevelTopicParticipation[]
  studentProgress          StudentProgress[]
  suggestedNextInAttempts  TestAttempt[]             @relation("SuggestedNextLevel")
  dailyChallenges          DailyChallenge[]
  topicMasteries           TopicMastery[]
  classroomTestedIn        ClassroomAssessmentSession[] @relation("ClassroomTestedLevel")
  classroomJudgedIn        ClassroomAssessmentEntry[]   @relation("ClassroomJudgedLevel")
}

model Topic {
  id   String @id @default(cuid())
  name String

  questions                Question[]
  levelTopicParticipations LevelTopicParticipation[]
  subjectChapters          SubjectChapter[]
  topicPerformance         TopicPerformance[]
  lesson                   TopicLesson?
  masteries                TopicMastery[]

  @@unique([name])
}

/// Per-level: total questions in one test (e.g. 8 for level 0)
model LevelTestConfig {
  id            String @id @default(cuid())
  levelId       String @unique @map("level_id")
  questionCount Int    @map("question_count")
  level         Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
}

/// Which topics supply questions for a level test; quota null = split remaining evenly
model LevelTopicParticipation {
  id        String @id @default(cuid())
  levelId   String @map("level_id")
  topicId   String @map("topic_id")
  quota     Int?
  sortOrder Int    @default(0) @map("sort_order")
  level     Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  topic     Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([levelId, topicId])
  @@index([levelId])
}

model Question {
  id               String       @id @default(cuid())
  subjectId        String       @map("subject_id")
  /// Null for chapter-mode book questions (no level).
  levelId          String?      @map("level_id")
  topicId          String       @map("topic_id")
  /// Set only when the question is filed under a topic inside a book chapter.
  chapterTopicId   String?      @map("chapter_topic_id")
  type             QuestionType @default(MCQ)
  stem             String
  stemImageUrl     String?      @map("stem_image_url")
  optionA          String       @default("") @map("option_a")
  optionB          String       @default("") @map("option_b")
  optionC          String       @default("") @map("option_c")
  optionD          String       @default("") @map("option_d")
  optionImageA     String?      @map("option_image_a")
  optionImageB     String?      @map("option_image_b")
  optionImageC     String?      @map("option_image_c")
  optionImageD     String?      @map("option_image_d")
  /// 0=A, 1=B, 2=C, 3=D — unused for NUMERIC
  correctOption    Int          @default(0) @map("correct_option")
  correctNumeric   Float?       @map("correct_numeric")
  numericTolerance Float        @default(0) @map("numeric_tolerance")
  difficulty       Difficulty   @default(MEDIUM)
  contentHash      String     @map("content_hash")
  parentQuestionId String?    @map("parent_question_id")
  createdById      String?    @map("created_by_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level        Level?        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chapterTopic ChapterTopic? @relation(fields: [chapterTopicId], references: [id], onDelete: SetNull)
  parent     Question?  @relation("QuestionVariations", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  variations Question[] @relation("QuestionVariations")
  createdBy  User?      @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  testQuestions           TestQuestion[]
  studentAnswers          StudentAnswer[]
  dailyChallengeQuestions DailyChallengeQuestion[]
  masterySessionQuestions MasterySessionQuestion[]
  reports                 QuestionReport[]

  @@unique([contentHash])
  @@index([topicId])
  @@index([chapterTopicId])
  @@index([subjectId, levelId])
}

model Test {
  id               String     @id @default(cuid())
  studentId        String     @map("student_id")
  subjectId        String     @map("subject_id")
  /// Null for chapter-mode tests (no level).
  levelId          String?    @map("level_id")
  selectedTopicIds        String[]   @default([]) @map("selected_topic_ids")
  /// Topics inside chapters. Empty when the student ticked whole chapters only.
  selectedChapterTopicIds String[]   @default([]) @map("selected_chapter_topic_ids")
  /// Snapshot at start. 0 = no negative marking (level tests always 0).
  wrongPenalty     Float      @default(0) @map("wrong_penalty")
  status           TestStatus @default(IN_PROGRESS)
  startedAt        DateTime   @default(now()) @map("started_at")
  completedAt      DateTime?  @map("completed_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  testQuestions TestQuestion[]
  attempts      TestAttempt[]
  questionReports QuestionReport[]

  @@index([studentId, status, completedAt])
  @@index([startedAt])
  @@index([subjectId, levelId])
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String   @map("test_id")
  questionId String   @map("question_id")
  orderIndex Int      @map("order_index")
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, orderIndex])
  @@index([testId])
}

model TestAttempt {
  id                   String          @id @default(cuid())
  testId               String          @unique @map("test_id")
  score                Float
  maxScore             Int             @map("max_score")
  percentage           Float
  band                 PerformanceBand
  suggestedNextLevelId String?         @map("suggested_next_level_id")
  completedAt          DateTime        @default(now()) @map("completed_at")

  test               Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  suggestedNextLevel Level?          @relation("SuggestedNextLevel", fields: [suggestedNextLevelId], references: [id], onDelete: SetNull)
  studentAnswers     StudentAnswer[]
}

model StudentAnswer {
  id             String  @id @default(cuid())
  testAttemptId  String  @map("test_attempt_id")
  questionId     String  @map("question_id")
  selectedOption Int?    @map("selected_option")
  numericAnswer  Float?  @map("numeric_answer")
  isCorrect      Boolean @map("is_correct")

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testAttemptId, questionId])
}

model StudentProgress {
  id             String    @id @default(cuid())
  studentId      String    @map("student_id")
  subjectId      String    @map("subject_id")
  levelId        String    @map("level_id")
  unlocked       Boolean   @default(false)
  lastPercentage Float?    @map("last_percentage")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, levelId])
  @@index([studentId, subjectId])
}

model TopicPerformance {
  id             String   @id @default(cuid())
  studentId      String   @map("student_id")
  topicId        String   @map("topic_id")
  correctTotal   Int      @default(0) @map("correct_total")
  attemptedTotal Int      @default(0) @map("attempted_total")
  updatedAt      DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([topicId])
}

/// Optional short lesson shown in the Learn step of topic mastery.
model TopicLesson {
  id        String   @id @default(cuid())
  topicId   String   @unique @map("topic_id")
  title     String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

/// Per-student mastery pipeline for a skill topic at a level.
model TopicMastery {
  id               String             @id @default(cuid())
  studentId        String             @map("student_id")
  topicId          String             @map("topic_id")
  subjectId        String             @map("subject_id")
  levelId          String             @map("level_id")
  status           TopicMasteryStatus @default(NEEDS_WORK)
  learnCompletedAt DateTime?          @map("learn_completed_at")
  lastPracticePct  Float?             @map("last_practice_pct")
  lastPracticeAt   DateTime?          @map("last_practice_at")
  lastRecheckPct   Float?             @map("last_recheck_pct")
  lastRecheckAt    DateTime?          @map("last_recheck_at")
  masteredAt       DateTime?          @map("mastered_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic    Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subject  Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level    Level            @relation(fields: [levelId], references: [id], onDelete: Cascade)
  sessions MasterySession[]

  @@unique([studentId, topicId, levelId])
  @@index([studentId, status])
  @@index([topicId])
}

model MasterySession {
  id             String               @id @default(cuid())
  studentId      String               @map("student_id")
  topicMasteryId String               @map("topic_mastery_id")
  kind           MasterySessionKind
  status         MasterySessionStatus @default(IN_PROGRESS)
  score          Int?
  maxScore       Int?                 @map("max_score")
  percentage     Float?
  xpAwarded      Int?                 @map("xp_awarded")
  startedAt      DateTime             @default(now()) @map("started_at")
  completedAt    DateTime?            @map("completed_at")

  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicMastery TopicMastery            @relation(fields: [topicMasteryId], references: [id], onDelete: Cascade)
  questions    MasterySessionQuestion[]

  @@index([studentId, status])
  @@index([topicMasteryId])
}

model MasterySessionQuestion {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  questionId     String   @map("question_id")
  orderIndex     Int      @map("order_index")
  selectedOption Int?     @map("selected_option")
  numericAnswer  Float?   @map("numeric_answer")
  isCorrect      Boolean? @map("is_correct")

  session  MasterySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
}

enum QuestionReportReason {
  WRONG_ANSWER
  UNCLEAR
  BAD_DIAGRAM
  OTHER
}

enum QuestionReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A student flag that a question from a finished test looks wrong. Does not change the score.
model QuestionReport {
  id           String               @id @default(cuid())
  questionId   String               @map("question_id")
  studentId    String               @map("student_id")
  testId       String               @map("test_id")
  reason       QuestionReportReason
  note         String               @default("")
  status       QuestionReportStatus @default(OPEN)
  createdAt    DateTime             @default(now()) @map("created_at")
  resolvedAt   DateTime?            @map("resolved_at")
  resolvedById String?              @map("resolved_by_id")

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("QuestionReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([questionId, studentId, testId])
  @@index([status, createdAt])
  @@index([questionId, status])
}

model QuestionImport {
  id                String   @id @default(cuid())
  filename          String
  uploadedById      String   @map("uploaded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  importedCount     Int      @default(0) @map("imported_count")
  skippedDuplicates Int      @default(0) @map("skipped_duplicates")
  errorsJson        String?  @map("errors_json")

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model AttendanceSession {
  id        String   @id @default(cuid())
  classId   String   @map("class_id")
  sectionId String   @map("section_id")
  date      DateTime
  takenById String?  @map("taken_by_id")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schoolClass SchoolClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  entries     AttendanceEntry[]
  takenBy     User?             @relation("AttendanceTakenBy", fields: [takenById], references: [id], onDelete: SetNull)

  @@unique([classId, sectionId, date])
  @@index([date])
  @@index([classId, sectionId])
}

model AttendanceEntry {
  id        String           @id @default(cuid())
  sessionId String           @map("session_id")
  studentId String           @map("student_id")
  status    AttendanceStatus @default(PRESENT)
  remark    String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum SubjectTestMode {
  LEVEL
  CHAPTER
}

enum ClassroomAssessmentKind {
  MARKS
  ORAL
}

/// Teacher-entered classroom assessment (paper marks or oral placement). Separate from online tests.
model ClassroomAssessmentSession {
  id            String                   @id @default(cuid())
  classId       String                   @map("class_id")
  sectionId     String                   @map("section_id")
  subjectId     String                   @map("subject_id")
  kind          ClassroomAssessmentKind
  date          DateTime
  /// MARKS: level tested. ORAL: unused.
  testedLevelId String?                  @map("tested_level_id")
  /// Unique scope: tested level id for MARKS, "oral" for ORAL.
  scopeKey      String                   @map("scope_key")
  notes         String?
  recordedById  String?                  @map("recorded_by_id")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  schoolClass SchoolClass                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section                     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject                     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  testedLevel Level?                      @relation("ClassroomTestedLevel", fields: [testedLevelId], references: [id], onDelete: SetNull)
  recordedBy  User?                       @relation("ClassroomRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  entries     ClassroomAssessmentEntry[]

  @@unique([classId, sectionId, subjectId, kind, date, scopeKey], map: "ClassroomAssessmentSession_scope_unique")
  @@index([date])
  @@index([classId, sectionId])
  @@index([subjectId, kind])
}

model ClassroomAssessmentEntry {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  studentId     String   @map("student_id")
  absent        Boolean  @default(false)
  score         Int?
  maxScore      Int?     @map("max_score")
  percentage    Float?
  judgedLevelId String?  @map("judged_level_id")
  remark        String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  session     ClassroomAssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  judgedLevel Level?                     @relation("ClassroomJudgedLevel", fields: [judgedLevelId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([judgedLevelId])
}

enum CareCallYesNo {
  YES
  NO
}

/// One monthly parent care call. Always insert a new row; never overwrite history.
model CareCall {
  id                    String         @id @default(cuid())
  studentId             String         @map("student_id")
  calledAt              DateTime       @map("called_at")
  englishMirrorPractice CareCallYesNo? @map("english_mirror_practice")
  heavyPhoneTv          CareCallYesNo? @map("heavy_phone_tv")
  recordedById          String?        @map("recorded_by_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("CareCallRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, calledAt])
  @@index([recordedById])
}

/// Singleton row (id = "default") for school name and logo on certificates, etc.
model SchoolBranding {
  id         String   @id @default("default")
  schoolName String   @default("Your School") @map("school_name")
  logoUrl    String?  @map("logo_url")
  updatedAt  DateTime @updatedAt @map("updated_at")
}

enum SaturdayHolidayRule {
  NONE
  SECOND
  ALL
}

enum SchoolHolidayKind {
  EXTRA
  WORKING
}

/// Singleton: Sundays off and which Saturdays are holidays.
model SchoolHolidaySettings {
  id           String              @id @default("default")
  sundaysOff   Boolean             @default(true) @map("sundays_off")
  saturdayRule SaturdayHolidayRule @default(SECOND) @map("saturday_rule")
  updatedAt    DateTime            @updatedAt @map("updated_at")
}

/// Extra holiday dates, or a default holiday turned into a working day.
model SchoolHolidayException {
  id        String            @id @default(cuid())
  date      DateTime          @unique
  kind      SchoolHolidayKind
  name      String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([date])
}

enum FeeChargeKind {
  MONTHLY
  ANNUAL
  ADMISSION
  EXAM
  OTHER
  OPENING
}

enum FeePaymentMode {
  CASH
  UPI
  BANK
}

/// One ledger for a child, or for a sibling group. School totals count each row once.
model FeeAccount {
  id         String   @id @default(cuid())
  parentName String?  @map("parent_name")
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  members  FeeAccountMember[]
  charges  FeeCharge[]
  payments FeePayment[]
}

model FeeAccountMember {
  id            String   @id @default(cuid())
  feeAccountId  String   @map("fee_account_id")
  studentId     String   @unique @map("student_id")
  usesTransport Boolean  @default(false) @map("uses_transport")
  createdAt     DateTime @default(now()) @map("created_at")

  feeAccount FeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([feeAccountId])
}

/// Class fee amounts for one academic year (April–March). Rupees.
model FeeStructure {
  id              String @id @default(cuid())
  academicYear    String @map("academic_year")
  classId         String @map("class_id")
  tuitionAmount   Int    @default(0) @map("tuition_amount")
  transportAmount Int    @default(0) @map("transport_amount")
  annualAmount    Int    @default(0) @map("annual_amount")
  admissionAmount Int    @default(0) @map("admission_amount")
  examAmount      Int    @default(0) @map("exam_amount")
  updatedAt       DateTime @updatedAt @map("updated_at")

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([academicYear, classId])
  @@index([academicYear])
}

model FeeCharge {
  id           String        @id @default(cuid())
  feeAccountId String        @map("fee_account_id")
  kind         FeeChargeKind
  /// MONTHLY: YYYY-MM. ANNUAL/ADMISSION/EXAM: academic year. OTHER/OPENING: unique key.
  periodKey    String        @map("period_key")
  amount       Int
  note         String?
  detailJson   String?       @map("detail_json")
  createdById  String?       @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  feeAccount FeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("FeeChargeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([feeAccountId, kind, periodKey])
  @@index([feeAccountId])
  @@index([kind, periodKey])
}

model FeePayment {
  id                       String         @id @default(cuid())
  feeAccountId             String         @map("fee_account_id")
  amount                   Int
  mode                     FeePaymentMode
  receiptNo                String         @unique @map("receipt_no")
  /// IST calendar day YYYY-MM-DD
  paidOn                   String         @map("paid_on")
  note                     String?
  recordedAgainstStudentId String?        @map("recorded_against_student_id")
  createdById              String?        @map("created_by_id")
  createdAt                DateTime       @default(now()) @map("created_at")

  feeAccount             FeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  recordedAgainstStudent Student?   @relation("FeePaymentAgainstStudent", fields: [recordedAgainstStudentId], references: [id], onDelete: SetNull)
  createdBy              User?      @relation("FeePaymentRecordedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([feeAccountId])
  @@index([paidOn])
}

model FeeReceiptSeq {
  academicYear String @id @map("academic_year")
  lastNumber   Int    @default(0) @map("last_number")
}
